PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/pbls_rescue_path
NODE_ENV=development

# Silences dotenv's own "injected env (n) from ... // tip: ..." banner
# (including its promotional tips for unrelated third-party products) on
# every load. Purely cosmetic — has no effect on which variables load.
DOTENV_CONFIG_QUIET=true

# Signs and verifies both token systems (admin and participant — see
# CLAUDE.md's Auth model). Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit a real value. Rotating it instantly signs out every admin
# and participant.
JWT_SECRET=

# Only needed if the client is served from a different origin than this
# API (e.g. a static host/CDN in front of the client, this API elsewhere).
# Comma-separated if there's more than one. Leave unset when client and
# API share an origin (e.g. both behind one reverse proxy) — no CORS
# headers are sent at all in that case, which is what same-origin needs.
CLIENT_ORIGIN=

# Dev-only fallback so a developer (or the e2e suite) can call the API
# without signing in first. Only ever takes effect when NO Authorization
# header is presented — a real token always wins — and requireAdmin/
# requireParticipant refuse to honour it when NODE_ENV=production even if
# left set. In production, DELETE these three lines entirely rather than
# setting them blank/false — the server now refuses to even start if
# NODE_ENV=production and any of the three is present at all (regardless
# of value), on the theory that their mere presence means a dev .env
# leaked into the production environment (docs/DEPLOY.md).
ALLOW_DEV_AUTH_BYPASS=false
DEV_PARTICIPANT_ID=
DEV_ADMIN_ID=
