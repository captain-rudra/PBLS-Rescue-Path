# Baked into the production bundle at BUILD time (Vite only exposes
# VITE_-prefixed vars to client code, and only whatever was set when
# `npm run build` ran — setting it on the server that serves the built
# files afterward has no effect). Leave unset/empty for a same-origin
# deployment (client and API behind one reverse proxy, or the Vite dev
# proxy locally) — every request already uses a path starting with "/",
# so an empty base means "call my own origin", which needs no
# configuration at all.
#
# Set this only when the client is served from a different origin than
# the API (e.g. a static host/CDN in front of the client, a separate
# service for the API) — the absolute API origin, no trailing slash:
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Dev-server only (scripts/dev.js, vite.config.js) — where the Vite dev
# proxy forwards /auth, /play/*, /admin/* while `npm run dev` is running.
# Never bundled into client code, never read in production. Defaults to
# http://localhost:3000, matching the server's own PORT default.
VITE_API_TARGET=http://localhost:3000
